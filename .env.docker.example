APP_NAME="TodoApp"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=Asia/Phnom_Penh
APP_URL=http://47.131.229.5:8081
APP_PORT=8081

# Required only by compose.prod.yaml when pulling from Docker Hub.
DOCKERHUB_USERNAME=your_dockerhub_username

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
LOG_CHANNEL=stderr
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=todo_app
DB_USERNAME=todo_user
DB_PASSWORD=CHANGE_TODO_USER_PASSWORD

MYSQL_DATABASE=todo_app
MYSQL_USER=todo_user
MYSQL_PASSWORD=CHANGE_TODO_USER_PASSWORD
MYSQL_ROOT_PASSWORD=CHANGE_MYSQL_ROOT_PASSWORD

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
CACHE_STORE=database
QUEUE_CONNECTION=sync

WAIT_FOR_DB=true
DB_WAIT_RETRIES=30
RUN_MIGRATIONS=true
RUN_SEEDERS=false

